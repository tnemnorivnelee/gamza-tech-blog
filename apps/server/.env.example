# 비밀값은 값을 비워 두고 이름만 적는다. 실제 값은 .env에만 둔다(.env는 커밋하지 않는다).
NODE_ENV=development
PORT=3000
# 명세의 servers 주소(선택). 프론트 gen:api가 이 주소를 BASE_PATH로 쓴다.
OPENAPI_SERVER_URL=
# JWT 서명 키(필수). Base64로 풀었을 때 32바이트 이상이어야 한다. 만드는 법: openssl rand -base64 32
JWT_SECRET=
# 토큰 수명(초). 옛 기본값은 액세스 1시간, 리프레시 30일이다.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# 로컬 MySQL·Redis(docker-compose.dev.yml)의 비밀번호. Compose만 읽고 Nest는 아직 읽지 않는다.
# 서버가 연결하는 작업(Redis는 M2-4, DB는 M4)에서 환경변수 검증에 추가한다.
# 영문·숫자만 나오게 만든다(연결 주소에 그대로 넣을 수 있다). 만드는 법: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
