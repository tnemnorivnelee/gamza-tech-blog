# 비밀값은 값을 비워 두고 이름만 적는다. 실제 값은 .env에만 둔다(.env는 커밋하지 않는다).
NODE_ENV=development
PORT=3000
# 명세의 servers 주소(선택). 프론트 gen:api가 이 주소를 BASE_PATH로 쓴다.
OPENAPI_SERVER_URL=
# JWT 서명 키(필수). Base64로 풀었을 때 32바이트 이상이어야 한다. 만드는 법: openssl rand -base64 32
JWT_SECRET=
# 토큰 수명(초). 옛 기본값은 액세스 1시간, 리프레시 30일이다.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
# 쿠키의 Domain 속성(예: .gamza.xyz). 비우면 속성을 생략해서 요청한 호스트에만 붙는다. 운영(NODE_ENV=production)에서는 필수다.
COOKIE_DOMAIN=

# Redis 접속 정보. 기본값은 로컬 Compose(docker-compose.dev.yml)가 여는 주소다. 로컬에서는 비밀번호만 채우면 된다.
# 비밀번호는 비워 두면 인증 없이 연결한다. 로컬 Compose는 6379로 고정이라 REDIS_PORT를 바꾸면 Compose와 어긋난다.
# yarn test의 Redis 시험도 REDIS_로 시작하는 값만 이 파일에서 읽는다(Redis가 떠 있지 않으면 그 시험만 건너뛴다).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# GitHub 로그인용 OAuth 앱 정보. 운영에서는 필수이고, 로컬에서는 비워 두면 서버는 뜨지만 로그인 요청에서 막힌다.
# 앱은 GitHub > Settings > Developer settings > OAuth Apps에서 만든다. 콜백 주소는 앱에 등록한 값과 같아야 한다.
# 로컬 예: http://localhost:3000/login/oauth2/code/github (PORT를 바꿨으면 같이 바꾼다). 값은 채팅·커밋에 적지 않는다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
# 로그인이 끝나면 https://{location}.{접미사}로 돌려보낸다. location은 콜백 요청의 ?location= 값이 허용 목록(쉼표로 구분)에 있을 때만 쓰고,
# 아니면 기본값을 쓴다. 줄을 지우면 아래 값(새 프론트 blog.gamza.xyz)이 기본값이다. 로컬 프론트(localhost:3000)로는 돌아올 수 없다.
OAUTH_REDIRECT_DOMAIN_SUFFIX=gamza.xyz
OAUTH_DEFAULT_LOCATION=blog
OAUTH_ALLOWED_LOCATIONS=blog

# MySQL 접속 주소(Prisma). 모양: mysql://사용자:비밀번호@호스트:포트/DB이름. 로컬 Compose의 MySQL은 사용자 gamza, DB gamza, 주소 127.0.0.1:3306이고
# 비밀번호는 아래 MYSQL_PASSWORD와 같은 값이다. 비밀번호가 들어 있어서 값은 채팅·커밋에 적지 않는다. 운영에서는 필수다.
# 지금은 prisma 명령(yarn workspace @gamza/server prisma ...)이 이 파일에서 읽는다. 서버는 아직 DB에 연결하지 않는다(M4-2에서 연결).
DATABASE_URL=

# 로컬 MySQL·Redis(docker-compose.dev.yml)의 비밀번호. Compose가 읽고, REDIS_PASSWORD는 Nest도 읽는다.
# 영문·숫자만 나오게 만든다(연결 주소에 그대로 넣을 수 있다). 만드는 법: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
